# ==========================================
# Local Development Environment — Safe to Commit
# ==========================================
# Infrastructure config for local Docker dev environment.
# Secrets (JWT_SECRET, etc.) go in .env (gitignored).

# --- Database ---
DB_URL=postgres://postgres:prism@prism-db:5432/prism?sslmode=disable

# --- Redis ---
REDIS_ADDR=prism-redis:6379

# --- S3 / Minio ---
S3_ENDPOINT=http://prism-minio:9000
S3_REGION=us-east-1
S3_BUCKET=raw-documents
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Encryption (dev-only default) ---
LLM_KEY_ENCRYPTION_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# --- Frontend ---
VITE_API_URL=http://localhost:8080
