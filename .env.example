# ==========================================
# Project Prism Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit the real .env file to version control.
#
# For local development, infrastructure vars are in .env.dev (committed).
# This .env file only needs secrets that override .env.dev defaults.

# --- Authentication (REQUIRED) ---
# A random secret used to sign JWT tokens. MUST be at least 32 characters.
JWT_SECRET="change-me-to-a-random-64-char-string"

# --- CORS Configuration (REQUIRED) ---
# Comma-separated list of allowed origins. Gateway will not start without it.
ALLOWED_ORIGINS="http://localhost:3000"

# --- Infrastructure (all have defaults in .env.dev for local dev) ---
# DB_URL=postgres://USER:PASS@HOST:5432/DBNAME?sslmode=require
# REDIS_URL=rediss://HOST:6379/0 (use rediss:// for TLS)
# S3_ENDPOINT=                # Leave empty for real AWS S3
# S3_REGION=us-east-1
# S3_BUCKET=raw-documents
# AWS_ACCESS_KEY_ID=           # Leave empty for IAM role auth
# AWS_SECRET_ACCESS_KEY=       # Leave empty for IAM role auth

# --- Encryption ---
# LLM_KEY_ENCRYPTION_SECRET=   # 64-char hex string for AES-256 encryption
