# ==========================================
# Project Prism Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit the real .env file to version control.

# --- External LLM APIs ---
OPENAI_API_KEY="your_openai_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# --- Authentication ---
# A random secret used to sign JWT tokens. MUST be at least 32 characters.
JWT_SECRET="change-me-to-a-random-64-char-string"

# --- CORS Configuration ---
# Comma-separated list of allowed origins. REQUIRED - gateway will not start without it.
ALLOWED_ORIGINS="http://localhost:3000"

# --- Local Infrastructure Config (Optional to override) ---
# POSTGRES_PASSWORD=prism
# MINIO_ROOT_PASSWORD=minioadmin
